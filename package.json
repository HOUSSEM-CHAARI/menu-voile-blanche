{
  "name": "la-voile-blanche-menu",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "preview": "astro preview",
    "setup": "npm run db:migrate && npm run db:seed && npm run db:photos",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "db:verify": "node --env-file-if-exists=.env --import tsx scripts/verify.ts",
    "db:reset": "node --env-file-if-exists=.env --import tsx scripts/reset.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "node --env-file-if-exists=.env --import tsx scripts/screenshots.ts",
    "docs:content": "node --import tsx scripts/content-changes.ts",
    "db:photos": "node --env-file-if-exists=.env --import tsx scripts/photos.ts",
    "assets:icons": "node --import tsx scripts/assets/build-icons.ts",
    "lighthouse": "node --import tsx scripts/lighthouse.ts",
    "qr": "node --env-file-if-exists=.env --import tsx scripts/qr.ts"
  },
  "dependencies": {
    "@astrojs/node": "11.1.6",
    "@libsql/client": "0.18.0",
    "astro": "7.3.5",
    "drizzle-orm": "0.45.3",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/qrcode": "1.5.6",
    "astro-eslint-parser": "3.2.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
