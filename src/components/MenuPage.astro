---
import WaveLine from './brand/WaveLine.astro'
import Footer from './Footer.astro'
import Hero from './Hero.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { pick, ui } from '../lib/i18n'
import { getPublicMenu } from '../lib/menu'
import { formatPrice } from '../lib/price'
import { restaurantInfo } from '../lib/restaurant'
import type { Locale } from '../lib/types'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = ui(locale)
const menu = await getPublicMenu()
const info = restaurantInfo(menu.settings, locale)
---

<BaseLayout locale={locale}>
  <Hero locale={locale} info={info} />
  <main id="menu" class="wrap">
    {menu.sections.map(({ category, items }, index) => {
      const title = pick(locale, { fr: category.nameFr, ar: category.nameAr, en: category.nameEn })
      return (
        <section id={category.slug} class="section">
          {index > 0 && <WaveLine />}
          <h2 lang={title.lang}>{title.text}</h2>
          <ul role="list">
            {items.map((item) => {
              const name = pick(locale, { fr: item.nameFr, ar: item.nameAr, en: item.nameEn })
              return (
                <li id={item.slug} data-dish>
                  <span lang={name.lang} data-dish-name>
                    {name.text}
                  </span>
                  <span class="price" data-price>
                    {formatPrice(item.price, locale, item.priceUnit)}
                  </span>
                  {!item.isAvailable && <span> · {t.soldOut}</span>}
                </li>
              )
            })}
          </ul>
        </section>
      )
    })}
  </main>
  <Footer locale={locale} info={info} />
</BaseLayout>

<style>
  #menu {
    max-width: var(--measure);
  }
  .section {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6);
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: var(--w-title);
    font-size: var(--text-title);
    line-height: var(--leading-tight);
  }
  li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-2);
    font-family: var(--font-serif);
    font-weight: var(--w-dish);
    font-size: var(--text-dish);
  }
</style>
