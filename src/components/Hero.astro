---
import Logo from './brand/Logo.astro'
import WaveLine from './brand/WaveLine.astro'
import Icon from './Icon.astro'
import LangSwitch from './LangSwitch.astro'
import { ui } from '../lib/i18n'
import type { RestaurantInfo } from '../lib/restaurant'
import type { Locale } from '../lib/types'

interface Props {
  locale: Locale
  info: RestaurantInfo
}

const { locale, info } = Astro.props
const t = ui(locale)
---

<header class="hero" id="accueil">
  <div class="hero-bar wrap">
    <LangSwitch locale={locale} />
  </div>

  <div class="hero-brand wrap">
    <h1>
      <span class="sr-only">{info.name}</span>
      <Logo size={236} class="hero-logo" />
    </h1>
    {info.tagline.text && (
      <p class="tagline" lang={info.tagline.lang}>
        {info.tagline.text}
      </p>
    )}
    <WaveLine variant="hero" class="hero-wave" />
  </div>

  <ul class="actions wrap" role="list">
    {info.phoneHref && (
      <li>
        <a class="action" href={info.phoneHref}>
          <Icon name="phone" />
          <span>{t.call}</span>
        </a>
      </li>
    )}
    {info.mapUrl && (
      <li>
        <a class="action" href={info.mapUrl} target="_blank" rel="noopener noreferrer">
          <Icon name="pin" />
          <span>{t.directions}</span>
        </a>
      </li>
    )}
    {info.hours.text && (
      <li>
        <a class="action" href="#infos" data-hours-toggle aria-haspopup="dialog">
          <Icon name="clock" />
          <span>{t.hours}</span>
        </a>
      </li>
    )}
  </ul>

  {info.hours.text && (
    <div id="hours" class="hours-popover" popover aria-labelledby="hours-title">
      <p id="hours-title" class="hours-title">
        {t.hours}
      </p>
      <p lang={info.hours.lang}>{info.hours.text}</p>
      <button type="button" class="hours-close" popovertarget="hours" popovertargetaction="hide">
        <Icon name="close" />
        <span class="sr-only">{t.close}</span>
      </button>
    </div>
  )}
</header>

<script>
  // With popover support, "Hours" opens a small panel; otherwise it scrolls to the footer.
  const toggle = document.querySelector<HTMLAnchorElement>('[data-hours-toggle]')
  const panel = document.getElementById('hours')
  if (toggle && panel && 'showPopover' in panel) {
    toggle.addEventListener('click', (event) => {
      event.preventDefault()
      panel.togglePopover()
    })
  }
</script>

<style>
  .hero {
    padding-block-end: var(--space-6);
    text-align: center;
  }
  .hero-bar {
    display: flex;
    justify-content: flex-end;
    padding-block: var(--space-2);
  }
  .hero-brand {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    padding-block: var(--space-3) var(--space-5);
  }
  h1 {
    line-height: 0;
  }
  .hero-logo {
    color: var(--abyss);
  }
  .tagline {
    max-width: 30ch;
    color: var(--mist);
    font-size: 1.0625rem;
  }

  .actions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    gap: var(--space-2);
    max-width: 30rem;
    margin: 0 auto;
    padding: 0;
  }
  .action {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 48px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--shutter);
    border-radius: 999px;
    color: var(--shutter);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  .action:hover {
    background: var(--shutter);
    color: var(--foam);
  }

  .hours-popover {
    width: min(100% - 2rem, 24rem);
    padding: var(--space-5) var(--space-5) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--foam);
    color: var(--abyss);
    box-shadow: 0 18px 48px rgb(13 36 54 / 0.18);
    text-align: start;
  }
  .hours-popover::backdrop {
    background: rgb(13 36 54 / 0.35);
  }
  .hours-title {
    margin-block-end: var(--space-2);
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: var(--w-title);
  }
  .hours-close {
    position: absolute;
    inset-block-start: var(--space-2);
    inset-inline-end: var(--space-2);
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }

  /* The one orchestrated moment: the sail rises and the wave draws itself, once per visit. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.seen)) .hero-logo :global(.logo-sail) {
      animation: sail-rise 0.9s var(--ease-out) both;
    }
    :global(html:not(.seen)) .hero-wave :global(path) {
      stroke-dasharray: 1;
      animation: wave-draw 1.1s 0.25s var(--ease-out) both;
    }
  }
  @keyframes sail-rise {
    from {
      transform: translateY(10px);
      opacity: 0;
    }
  }
  @keyframes wave-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
