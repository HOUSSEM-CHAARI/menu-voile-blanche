---
/**
 * One dish on the menu, laid out like the printed carte: name, dotted leader, price.
 *  - standard: small 4:3 thumbnail when the dish has a photo
 *  - feature:  signature dishes, with a large photo (or the sail placeholder)
 *  - compact:  drinks and other simple items, no photo, no description
 * The whole row opens the detail sheet.
 */
import Badges from './Badges.astro'
import DishImage from './DishImage.astro'
import PriceTag from './PriceTag.astro'
import type { DishView } from '../../lib/dish-view'
import { ui } from '../../lib/i18n'
import type { Locale } from '../../lib/types'

interface Props {
  dish: DishView
  locale: Locale
  variant: 'standard' | 'feature' | 'compact'
}

const { dish, locale, variant } = Astro.props
const t = ui(locale)
const illustration = dish.imageSource === 'temporary' ? t.photoIllustration : null
const showIncludes = variant === 'feature' && dish.includes.items.length > 0
---

<article
  id={dish.slug}
  class:list={['dish', `dish--${variant}`, { 'is-soldout': dish.soldOut }]}
  data-dish
  data-kind={dish.kind}
  data-serves={dish.serves ?? 1}
  data-search={dish.search}
>
  {variant === 'feature' && (
    <DishImage
      class="dish-photo"
      image={dish.image}
      alt={dish.imageAlt}
      sizes="(min-width: 64rem) 20rem, (min-width: 48rem) 40vw, calc(100vw - 2rem)"
      illustrationLabel={illustration}
    />
  )}
  {variant === 'standard' && dish.image && (
    <DishImage class="dish-thumb" image={dish.image} alt={dish.imageAlt} sizes="6rem" />
  )}

  <div class="dish-body">
    <div class="dish-head">
      <h3 class="dish-name" lang={dish.name.lang} data-dish-name>
        <a href={`#${dish.slug}`} class="dish-link" data-open-dish={dish.slug}>
          {dish.name.text}
        </a>
      </h3>
      <span class="leader" aria-hidden="true"></span>
      <PriceTag price={dish.price} class="dish-price" />
    </div>

    {variant !== 'compact' && dish.description && (
      <p class="dish-description" lang={dish.description.lang}>
        {dish.description.text}
      </p>
    )}
    {variant !== 'compact' &&
      dish.options.map((option) => (
        <p class="dish-options">
          <span class="dish-options-label" lang={option.label.lang}>
            {option.label.text}
          </span>{' '}
          {option.choices.map((choice, index) => (
            <>
              {index > 0 && <span aria-hidden="true"> · </span>}
              <span lang={choice.lang}>{choice.text}</span>
            </>
          ))}
        </p>
      ))}
    {showIncludes && (
      <p class="dish-options" lang={dish.includes.lang}>
        <span class="dish-options-label">{t.includes}</span> {dish.includes.items.join(' · ')}
      </p>
    )}
    {variant === 'feature' && dish.note && (
      <p class="dish-note" lang={dish.note.lang}>
        {dish.note.text}
      </p>
    )}
    <Badges dish={dish} locale={locale} />
  </div>
</article>

<style>
  .dish {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-block-end: 1px solid var(--line);
  }
  .dish:has(.dish-thumb) {
    grid-template-columns: 6rem minmax(0, 1fr);
    align-items: start;
  }
  .dish:has(.dish-link:focus-visible) {
    outline: 2px solid var(--shutter);
    outline-offset: 4px;
    border-radius: var(--radius);
  }
  .dish-body {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .dish-head {
    display: flex;
    align-items: flex-end;
    gap: var(--space-3);
  }
  .dish-name {
    min-width: 0;
    font-family: var(--font-serif);
    font-size: var(--text-dish);
    font-weight: var(--w-dish);
    line-height: var(--leading-tight);
  }
  .dish-link {
    color: inherit;
    text-decoration: none;
  }
  .dish-link:focus-visible {
    outline: none;
  }
  /* The whole row is the link's hit area. */
  .dish-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .leader {
    flex: 1 1 1.5rem;
    min-width: 1.5rem;
    height: 0.25rem;
    margin-block-end: 0.45em;
    visibility: hidden;
    background: radial-gradient(circle, var(--mist) 0.9px, transparent 1.2px) center / 6px 4px
      repeat-x;
    opacity: 0.7;
  }
  .dish-price {
    font-size: 1.0625rem;
    line-height: var(--leading-tight);
  }
  .dish-description {
    color: var(--mist);
  }
  .dish-options {
    color: var(--abyss);
    font-size: 0.9375rem;
  }
  .dish-options-label {
    color: var(--mist);
  }
  .dish-options-label::after {
    content: ' :';
  }
  :global(:root:not(:lang(fr))) .dish-options-label::after {
    content: ':';
  }
  .dish-note {
    padding-inline-start: var(--space-3);
    border-inline-start: 2px solid var(--sand);
    font-size: 0.9375rem;
  }

  .dish-thumb {
    border-radius: var(--radius);
    overflow: hidden;
  }

  .dish--feature :global(.dish-photo) {
    border-radius: var(--radius);
    overflow: hidden;
  }
  .dish--feature .dish-name {
    font-size: calc(var(--text-dish) * 1.12);
  }

  .dish--compact {
    padding-block: var(--space-3);
  }

  .is-soldout .dish-name,
  .is-soldout .dish-price,
  .is-soldout .dish-description {
    color: var(--mist);
  }
  .is-soldout :global(.dish-thumb),
  .is-soldout :global(.dish-photo) {
    filter: grayscale(1);
    opacity: 0.6;
  }

  @media (hover: hover) {
    .dish:hover .dish-name {
      color: var(--shutter);
    }
  }

  /* The printed menu's dotted leaders, on screens wide enough for them. */
  @media (min-width: 48rem) {
    .leader {
      visibility: visible;
    }
    .dish--feature {
      grid-template-columns: 17rem minmax(0, 1fr);
      gap: var(--space-5);
      align-items: start;
    }
  }
</style>
