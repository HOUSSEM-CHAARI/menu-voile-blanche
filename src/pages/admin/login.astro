---
import { eq } from 'drizzle-orm'
import AdminLayout from '../../layouts/AdminLayout.astro'
import {
  clearFailures,
  createSession,
  isRateLimited,
  recordFailure,
  verifyPassword,
} from '../../lib/auth'
import { db } from '../../lib/db/client'
import { users } from '../../lib/db/schema'

let error = ''
let username = ''
const next = Astro.url.searchParams.get('next') ?? '/admin'
// Only same-site paths inside the back office are accepted as a return address.
const safeNext = /^\/admin(\/[\w\-/?=&%.]*)?$/.test(next) ? next : '/admin'

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  username = String(form.get('username') ?? '').trim()
  const password = String(form.get('password') ?? '')
  const keys = [`ip:${Astro.clientAddress}`, `user:${username.toLowerCase()}`]
  if (await isRateLimited(keys)) {
    error = 'Trop d’essais. Réessayez dans 15 minutes.'
  } else {
    const user = await db.select().from(users).where(eq(users.username, username)).get()
    const valid = user ? await verifyPassword(user.passwordHash, password) : false
    if (user && valid) {
      await clearFailures(keys)
      await createSession(user.id, Astro.cookies, Astro.url.protocol === 'https:')
      return Astro.redirect(safeNext)
    }
    await recordFailure(keys)
    error = 'Identifiant ou mot de passe incorrect.'
  }
}
---

<AdminLayout title="Connexion">
  <div class="login">
    <form method="post" class="panel stack">
      <svg width="36" height="45" aria-hidden="true">
        <use href="#vb-sail"></use>
      </svg>
      <h1>Back office</h1>
      <p class="muted">La Voile Blanche — gestion du menu.</p>
      {error && (
        <p class="error" role="alert">
          {error}
        </p>
      )}
      <div class="field">
        <label for="username">Identifiant</label>
        <input
          id="username"
          name="username"
          type="text"
          autocomplete="username"
          value={username}
          required
        />
      </div>
      <div class="field">
        <label for="password">Mot de passe</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
        />
      </div>
      <button type="submit" class="button">
        Se connecter
      </button>
    </form>
  </div>
</AdminLayout>
