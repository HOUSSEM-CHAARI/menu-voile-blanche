---
import '../styles/global.css'
import '../styles/admin.css'
import BrandSprite from '../components/brand/BrandSprite.astro'
import Icon, { type IconName } from '../components/Icon.astro'
import { takeFlash } from '../lib/flash'

type Section =
  'dashboard' | 'dishes' | 'categories' | 'trash' | 'history' | 'settings' | 'backup' | 'password'

interface Props {
  title: string
  /** Current section, highlighted in the navigation. */
  section?: Section
}

const { title, section } = Astro.props
const user = Astro.locals.user
const flash = takeFlash(Astro.cookies)
const groups: {
  label: string
  items: { key: Section; href: string; label: string; icon: IconName }[]
}[] = [
  {
    label: 'Menu',
    items: [
      { key: 'dashboard', href: '/admin', label: 'Tableau de bord', icon: 'dashboard' },
      { key: 'dishes', href: '/admin/plats', label: 'Plats', icon: 'waiter' },
      { key: 'categories', href: '/admin/categories', label: 'Catégories', icon: 'folder' },
    ],
  },
  {
    label: 'Gestion',
    items: [
      { key: 'settings', href: '/admin/reglages', label: 'Réglages', icon: 'sliders' },
      { key: 'backup', href: '/admin/sauvegarde', label: 'Sauvegarde', icon: 'download' },
      { key: 'history', href: '/admin/historique', label: 'Historique', icon: 'history' },
      { key: 'trash', href: '/admin/corbeille', label: 'Corbeille', icon: 'trash' },
    ],
  },
  {
    label: 'Compte',
    items: [{ key: 'password', href: '/admin/mot-de-passe', label: 'Mot de passe', icon: 'lock' }],
  },
]
const initial = user?.username.slice(0, 1).toUpperCase() ?? ''
---

<!doctype html>
<html lang="fr" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0d2436" />
    <title>{title} — Back office La Voile Blanche</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {user && <meta name="csrf-token" content={user.csrfToken} />}
  </head>
  <body class:list={['admin', { 'admin--guest': !user }]}>
    <BrandSprite />
    {user ? (
      <div class="shell">
        <header class="topbar">
          <button
            type="button"
            class="icon-btn"
            popovertarget="admin-nav"
            aria-label="Ouvrir le menu"
          >
            <Icon name="menu" />
          </button>
          <a class="brand" href="/admin">
            <svg width="20" height="26" aria-hidden="true">
              <use href="#vb-sail" />
            </svg>
            <span>La Voile Blanche</span>
          </a>
          <a class="icon-btn" href="/fr" target="_blank" rel="noopener" aria-label="Voir le menu">
            <Icon name="eye" />
          </a>
        </header>

        <aside class="sidebar" id="admin-nav" popover>
          <div class="sidebar-head">
            <a class="brand" href="/admin">
              <span class="brand-mark">
                <svg width="20" height="26" aria-hidden="true">
                  <use href="#vb-sail" />
                </svg>
              </span>
              <span class="brand-text">
                <strong>La Voile Blanche</strong>
                <small>Back office</small>
              </span>
            </a>
            <button
              type="button"
              class="icon-btn sidebar-close"
              popovertarget="admin-nav"
              popovertargetaction="hide"
              aria-label="Fermer le menu"
            >
              <Icon name="close" />
            </button>
          </div>
          <nav aria-label="Back office" class="sidebar-nav">
            {groups.map((group) => (
              <div class="nav-group">
                <p class="nav-label">{group.label}</p>
                <ul role="list">
                  {group.items.map((item) => (
                    <li>
                      <a href={item.href} aria-current={item.key === section ? 'page' : undefined}>
                        <Icon name={item.icon} />
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
          <div class="sidebar-foot">
            <a class="view-menu" href="/fr" target="_blank" rel="noopener">
              <Icon name="external" size={18} />
              Voir le menu
            </a>
            <div class="user-card">
              <span class="avatar" aria-hidden="true">
                {initial}
              </span>
              <span class="user-name">{user.username}</span>
              <form method="post" action="/admin/logout">
                <input type="hidden" name="_csrf" value={user.csrfToken} />
                <button type="submit" class="icon-btn" aria-label="Déconnexion" title="Déconnexion">
                  <Icon name="logout" size={18} />
                </button>
              </form>
            </div>
          </div>
        </aside>

        <main id="menu" class="admin-main">
          <slot />
        </main>
      </div>
    ) : (
      <main id="menu" class="admin-main">
        <slot />
      </main>
    )}
    {flash && (
      <p class:list={['toast', `toast--${flash.type}`]} role="status" data-toast>
        {flash.text}
      </p>
    )}
    <script>
      import '../scripts/admin'
    </script>
  </body>
</html>
