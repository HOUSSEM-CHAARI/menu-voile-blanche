# Database. Local SQLite file; for hosted libSQL (Turso) set a libsql:// URL and the token.
DATABASE_URL=file:./data/menu.db
DATABASE_AUTH_TOKEN=

# Public address of the menu, used for the QR code, canonical links and the sitemap.
PUBLIC_BASE_URL=http://localhost:4321

# Back office. The seed creates this account if it does not exist yet.
ADMIN_USERNAME=patron
ADMIN_PASSWORD=change-me-please

# Where uploaded and processed photos are stored locally. In Vercel production,
# connect a Vercel Blob store to the project: it sets BLOB_STORE_ID (newer stores, OIDC)
# or BLOB_READ_WRITE_TOKEN (older stores). BLOB_ACCESS=public|private is detected if unset.
UPLOAD_DIR=./data/uploads
BLOB_READ_WRITE_TOKEN=
