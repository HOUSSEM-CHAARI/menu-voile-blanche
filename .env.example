# Database. Local SQLite file; for hosted libSQL (Turso) set a libsql:// URL and the token.
DATABASE_URL=file:./data/menu.db
DATABASE_AUTH_TOKEN=

# Public address of the menu, used for the QR code, canonical links and the sitemap.
PUBLIC_BASE_URL=http://localhost:4321

# Back office (Phase 7). The seed creates this account if it does not exist yet.
ADMIN_USERNAME=patron
ADMIN_PASSWORD=change-me-please
# 32+ random characters. Generate one with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where uploaded and processed photos are stored.
UPLOAD_DIR=./data/uploads
